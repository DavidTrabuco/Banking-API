{
  "openapi": "3.0.1",
  "info": {
    "title": "BankingApi",
    "version": "1.0"
  },
  "paths": {
    "/api/Conta/detalhes": {
      "get": {
        "tags": [
          "Conta"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Conta/sacar": {
      "post": {
        "tags": [
          "Conta"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValorDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ValorDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ValorDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Conta/depositar": {
      "post": {
        "tags": [
          "Conta"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValorDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ValorDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ValorDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Conta/ConsultarSaldo": {
      "get": {
        "tags": [
          "Conta"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Conta": {
      "post": {
        "tags": [
          "Conta"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContaBancaria"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ContaBancaria"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ContaBancaria"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Conta/{id}": {
      "get": {
        "tags": [
          "Conta"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContaBancaria": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "titular": {
            "type": "string",
            "nullable": true
          },
          "saldo": {
            "type": "number",
            "format": "double",
            "readOnly": true
          },
          "enderecoCobranca": {
            "$ref": "#/components/schemas/Endereco"
          }
        },
        "additionalProperties": false
      },
      "Endereco": {
        "type": "object",
        "properties": {
          "rua": {
            "type": "string",
            "nullable": true
          },
          "cidade": {
            "type": "string",
            "nullable": true
          },
          "estado": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ValorDTO": {
        "type": "object",
        "properties": {
          "valor": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  }
}